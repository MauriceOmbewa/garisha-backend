# Version control
.git
.gitignore

# Local environment — never bake secrets into the image
.env
.env.*
!.env.example

# Go build artifacts
bin/
*.exe
*.test

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker files themselves (not needed inside the image)
Dockerfile
docker-compose*.yml
.dockerignore

# Docs and scripts (not needed at runtime)
docs/
scripts/
README.md
LICENSE
