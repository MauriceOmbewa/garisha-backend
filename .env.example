APP_NAME=
APP_ENV=
PORT=

DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SSLMODE=

JWT_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full backend callback URL registered in Google Cloud Console:
GOOGLE_REDIRECT_URL=https://api.yourdomain.com/api/v1/auth/google/callback
# Comma-separated list of frontend origins allowed to initiate the OAuth flow:
GOOGLE_ALLOWED_ORIGINS=https://www.example.com,http://localhost:8008
# Android OAuth client ID (no secret — uses package name + SHA-1 fingerprint):
GOOGLE_ANDROID_CLIENT_ID=
# iOS OAuth client ID (no secret — uses bundle ID):
GOOGLE_IOS_CLIENT_ID=

REDIS_HOST=
REDIS_PORT=

# M-PESA (Safaricom Daraja)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORT_CODE=
MPESA_CALLBACK_URL=
MPESA_ENVIRONMENT=sandbox

# Object Storage (S3-compatible: AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces)
STORAGE_ENDPOINT=s3.amazonaws.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_USE_SSL=true
STORAGE_PUBLIC_BASE_URL=
