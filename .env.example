APP_NAME=garisha-platform
APP_ENV=production
PORT=8088

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=garisha
DATABASE_SSLMODE=require

JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create a "Web application" client in Google Cloud Console → APIs & Services → Credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GOOGLE_REDIRECT_URL must be registered as an "Authorized redirect URI" in GCP.
# Add ALL environments you use (you can have multiple in GCP).
# Local:      http://localhost:8088/api/v1/auth/google/callback
# Production: https://your-backend.com/api/v1/auth/google/callback
GOOGLE_REDIRECT_URL=https://your-backend.com/api/v1/auth/google/callback

# Comma-separated list of frontend origins allowed to initiate the OAuth flow.
# These are the origins the "Continue with Google" button lives on.
# Local:      http://localhost:5173
# Production: https://your-frontend.vercel.app  (or your custom domain)
GOOGLE_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Mobile client IDs (no secret needed — verified by package name / bundle ID)
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ── CORS ─────────────────────────────────────────────────────────────────────
# The backend CORS middleware reads GOOGLE_ALLOWED_ORIGINS for the allowed list.
# No separate CORS env var needed — they share the same origin whitelist.

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379

# ── M-PESA (Safaricom Daraja) ─────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORT_CODE=
MPESA_CALLBACK_URL=
MPESA_ENVIRONMENT=sandbox

# ── Object Storage (S3-compatible) ────────────────────────────────────────────
STORAGE_ENDPOINT=s3.amazonaws.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_USE_SSL=true
STORAGE_PUBLIC_BASE_URL=
